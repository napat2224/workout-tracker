# Copy to .env and adjust. Every variable here is declared and validated in
# src/common/env.ts — the app refuses to boot if one is invalid.

# development | production | test
NODE_ENV=development

# Port the API listens on. Next.js owns 3000.
PORT=3001

# Origin allowed by CORS. Only affects direct browser -> API calls; requests
# proxied through the Next.js /api rewrite are same-origin.
WEB_ORIGIN=http://localhost:3000

# Insert demo workout data on boot. Set to false for an empty API.
SEED_DATA=true
