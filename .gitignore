# ---- dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- build output ----
.next/
out/
build/
dist/
coverage/
.nyc_output/

# ---- turborepo ----
.turbo/

# ---- typescript ----
*.tsbuildinfo
# Regenerated by `next dev` / `next build`; committing it causes churn.
next-env.d.ts

# ---- env ----
# Secrets stay local. `.env.example` is the committed template, so it is
# re-included after the blanket rule below.
.env
.env.*
!.env.example

# ---- logs & runtime ----
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids
*.pid
*.pid.lock
*.seed
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---- editors ----
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
.project
.classpath
.settings/

# ---- os ----
.DS_Store
Thumbs.db

# ---- misc ----
*.pem
.vercel
.temp
.tmp
